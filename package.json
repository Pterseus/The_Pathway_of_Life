{
	"name": "bun-react-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"build:bundle": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --public-path=/The_Pathway_of_Life/ --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
		"build:spa-fallback": "cp dist/index.html dist/404.html",
		"build": "bun run build:bundle && bun run build:spa-fallback",
		"start": "NODE_ENV=production bun src/index.ts"
	},
	"dependencies": {
		"@omuso/react-reader": "^0.3.0",
		"react": "^19",
		"react-dom": "^19"
	},
	"devDependencies": {
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^7"
	}
}
