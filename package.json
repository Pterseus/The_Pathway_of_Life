{
	"name": "bun-react-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"build:bundle": "bun build.ts",
		"build:spa-fallback": "cp dist/index.html dist/404.html",
		"build": "bun run build:bundle && bun run build:spa-fallback",
		"start": "NODE_ENV=production bun src/index.ts"
	},
	"dependencies": {
		"@omuso/react-reader": "^0.3.1",
		"react": "^19",
		"react-dom": "^19"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"bun-plugin-tailwind": "^0.1.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^7"
	}
}
